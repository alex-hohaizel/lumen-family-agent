# Секрети вводяться локально через npm run setup. Не надсилайте їх у групу.
TELEGRAM_BOT_TOKEN=
# Дізнатись власний ID: написати боту /id після запуску.
OWNER_TELEGRAM_ID=
DATABASE_URL=postgres://lumen:CHANGE_ME@localhost:5432/lumen
AUTH_MODE=chatgpt
# Виберіть через npm run models після входу. Модель автоматично не підміняється.
OPENAI_MODEL=
# ChatGPT: 0 — без додаткової добової межі застосунку; діють ліміти підписки.
# Додатне число задає власний добовий бюджет на групу. Окремий API має межу 200 за замовчуванням.
LUMEN_DAILY_TURN_LIMIT=0
# Лише для окремого платного API або медіа; ChatGPT-вхід його не потребує.
OPENAI_API_KEY=
IMAGE_MODEL=
TRANSCRIBE_MODEL=
ENABLE_WEB_SEARCH=false
TIMEZONE=Europe/Kyiv
QUIET_START=23
QUIET_END=9
RUNTIME_DIR=./runtime
HEALTH_PORT=8080
# Для Render: одноразовий захищений імпорт accounts.json у постійний runtime.
# Після імпорту чинна rotating session у runtime має пріоритет.
CHATGPT_ACCOUNTS_B64=
LUMEN_PAIRING_CODE=
