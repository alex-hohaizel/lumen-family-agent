{
  "name": "lumen-telegram",
  "version": "1.6.0",
  "private": true,
  "description": "Люмен — співрозмовник для Telegram-груп з окремою пам’яттю та контекстом тем",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "setup": "node --env-file-if-exists=.env dist/src/setup.js",
    "login": "node --env-file-if-exists=.env dist/src/auth.js login",
    "models": "node --env-file-if-exists=.env dist/src/auth.js models",
    "probe": "node --env-file-if-exists=.env dist/src/auth.js probe",
    "logout": "node --env-file-if-exists=.env dist/src/auth.js logout",
    "doctor": "node --env-file-if-exists=.env dist/src/doctor.js",
    "smoke": "node --env-file-if-exists=.env dist/src/smoke.js",
    "profile": "node --env-file-if-exists=.env dist/src/profile.js",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js"
  },
  "dependencies": {
    "@sparticuz/chromium": "153.0.0",
    "ffmpeg-static": "^5.3.0",
    "jose": "^6.1.3",
    "linkedom": "0.18.14",
    "pdf-parse": "2.4.5",
    "pg": "^8.23.1",
    "playwright-core": "1.61.1",
    "quickjs-emscripten": "0.32.0",
    "sharp": "^0.35.5",
    "tar-fs": "3.1.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "typescript": "^5.9.3"
  }
}
