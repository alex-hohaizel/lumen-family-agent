{
  "name": "lumen-telegram",
  "version": "1.13.4",
  "private": true,
  "description": "Люмен — співрозмовник для Telegram-груп з окремою пам’яттю та контекстом тем",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node tools/release/clean.mjs dist && tsc -p tsconfig.json",
    "build:test": "node tools/release/clean.mjs .test-build && tsc -p tsconfig.test.json",
    "build:release": "npm run build && npm run package:release",
    "package:release": "node tools/release/package.mjs",
    "verify:release": "node tools/release/verify.mjs",
    "verify": "npm test && npm run package:release && npm run verify:release",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "setup": "node --env-file-if-exists=.env dist/src/setup.js",
    "login": "node --env-file-if-exists=.env dist/src/auth.js login",
    "models": "node --env-file-if-exists=.env dist/src/auth.js models",
    "probe": "node --env-file-if-exists=.env dist/src/auth.js probe",
    "logout": "node --env-file-if-exists=.env dist/src/auth.js logout",
    "doctor": "node --env-file-if-exists=.env dist/src/doctor.js",
    "smoke": "node --env-file-if-exists=.env dist/src/smoke.js",
    "profile": "node --env-file-if-exists=.env dist/src/profile.js",
    "test": "npm run build && npm run build:test && node --test --test-concurrency=1 .test-build/test/*.test.js && node --test tools/release/*.test.mjs tools/diagnostics/*.test.mjs",
    "ingress": "node --env-file-if-exists=.env dist/src/transport-repair.js",
    "diagnostics": "node --env-file-if-exists=.env dist/src/main.js --diagnostics"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@sparticuz/chromium": "153.0.0",
    "docx-preview": "^0.4.1",
    "fast-xml-parser": "^5.11.2",
    "ffmpeg-static": "^5.3.0",
    "ical.js": "^2.2.1",
    "jose": "^6.1.3",
    "jszip": "^3.10.2",
    "linkedom": "0.18.14",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "2.4.5",
    "pg": "^8.23.1",
    "playwright-core": "1.61.1",
    "quickjs-emscripten": "0.32.0",
    "sharp": "^0.35.5",
    "tar-fs": "3.1.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "typescript": "^5.9.3"
  }
}
